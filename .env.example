# Copy to ".env" (same folder as docker-compose.yml). Do NOT commit ".env".
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:8080

# Optional: AI + email (leave empty to run without them)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
